# Base de datos PostgreSQL (Supabase)
# DATABASE_URL: conexión pooled (Supavisor / pgbouncer, puerto 6543) para runtime serverless.
# DIRECT_URL:   conexión directa (puerto 5432) para migraciones (prisma migrate / db push).
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"

# API de resultados de fútbol
FOOTBALL_DATA_API_KEY="tu-api-key-de-football-data.org"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Polla Mundialera <noreply@tu-dominio.com>"

# Web Push (VAPID) - genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxA"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:admin@tu-dominio.com"

# Seguridad de Cron Jobs
CRON_SECRET="genera-uno-con: openssl rand -base64 32"
